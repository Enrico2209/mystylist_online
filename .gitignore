node_modules/
dist/
.DS_Store

# Contiene la stringa di connessione al database e il segreto dei token:
# in produzione questi valori si mettono fra le variabili d'ambiente di
# Render, mai in un file che finisce nel repository.
.env
.env.local
*.env

# I file di lavoro della pipeline non appartengono al repo della UI
*.parquet
*.jsonl

# ...ma server/dati/outfits_ui.json e mystylist/public/media SÌ: sono la
# versione web (43 MB di immagini ridimensionate) ed è quella che Render
# pubblica. Senza, il sito online non avrebbe né dati né foto.
!server/dati/outfits_ui.json
!mystylist/public/media/
